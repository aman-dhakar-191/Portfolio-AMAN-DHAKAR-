        ".write": "$uid === auth.uid"
      }
    },
    "projects": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid"
      }
    },
    "certificates": {
      "$uid": {
        ".read": true,
        ".write": "$uid === auth.uid"
      }
    }
  }
}
